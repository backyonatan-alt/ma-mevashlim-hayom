---
interface Props {
  title?: string;
  description?: string;
  /** Home page renders its own hero title, so the header bar is hidden. */
  hideHeader?: boolean;
}

const SITE_NAME = 'מה מבשלים היום';
const { title, description = 'ספר המתכונים המשפחתי של יונתן וענבר', hideHeader = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
import '../styles/global.css';
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf6ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    {!hideHeader && (
      <header class="site-header">
        <div class="site-header__inner">
          <a class="site-title" href="/">{SITE_NAME}</a>
        </div>
      </header>
    )}
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">{SITE_NAME}</footer>
  </body>
</html>
