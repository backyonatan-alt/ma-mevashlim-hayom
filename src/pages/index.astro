---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rule from '../components/Rule.astro';
import { CATEGORIES } from '../content.config';
import { formatMinutes } from '../lib/parseRecipe';

const FALLBACK_EMOJI = '🍽️';

const recipes = (await getCollection('recipes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'he'),
);

/** Same normalization the client script applies to the query. */
const normalize = (s: string) =>
  s
    .toLowerCase()
    .replace(/[֑-ׇ]/g, '')
    .replace(/["'״׳]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const searchText = (r: (typeof recipes)[number]) =>
  normalize([r.data.title, r.data.category, ...r.data.tags].join(' '));
---

<Base hideHeader>
  <div class="home">
    <header class="hero">
      <span class="hero__emoji" aria-hidden="true">🍳</span>
      <h1 class="hero__title">מה מבשלים היום</h1>
      <p class="hero__sub">ספר המתכונים של יונתן וענבר</p>
      <div class="hero__rule"><Rule /></div>
    </header>

    <form class="search" role="search" onsubmit="return false">
      <label class="visually-hidden" for="search">חיפוש מתכון</label>
      <input
        class="search__input"
        id="search"
        type="search"
        placeholder="🔍 חיפוש לפי שם, תגית או קטגוריה…"
        autocomplete="off"
        enterkeyhint="search"
      />
    </form>

    <div class="chips" role="group" aria-label="סינון לפי קטגוריה">
      <button class="chip" type="button" data-cat="" aria-pressed="true">הכל</button>
      {CATEGORIES.map((cat) => (
        <button class="chip" type="button" data-cat={cat} aria-pressed="false">{cat}</button>
      ))}
    </div>


    <p class="status" id="status" aria-live="polite">{recipes.length} מתכונים</p>

    <ul class="cards" id="cards">
      {recipes.map((r) => (
        <li class="card" data-category={r.data.category} data-search={searchText(r)}>
          <a class="card__link" href={`/recipes/${r.id}`}>
            <span class="card__tile" aria-hidden="true">{r.data.emoji ?? FALLBACK_EMOJI}</span>
            <span class="card__body">
              <span class="card__title">
                {r.data.title}
                {r.data.family && <span class="card__badge">שלנו</span>}
              </span>
              <span class="card__meta">
                {r.data.category}
                {r.data.totalTime && <> · {formatMinutes(r.data.totalTime)}</>}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="empty" id="empty" hidden>לא נמצאו מתכונים. נסו מילה אחרת או קטגוריה אחרת.</p>
  </div>
</Base>

<script>
  const input = document.getElementById('search') as HTMLInputElement;
  const status = document.getElementById('status')!;
  const empty = document.getElementById('empty')!;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const cards = Array.from(document.querySelectorAll<HTMLLIElement>('.card'));
  let category = '';

  const normalize = (s: string) =>
    s
      .toLowerCase()
      .replace(/[֑-ׇ]/g, '')
      .replace(/["'״׳]/g, '')
      .replace(/\s+/g, ' ')
      .trim();

  function apply() {
    const q = normalize(input.value);
    let shown = 0;
    for (const card of cards) {
      const ok =
        (!category || card.dataset.category === category) &&
        (!q || (card.dataset.search ?? '').includes(q));
      card.hidden = !ok;
      if (ok) shown++;
    }
    status.textContent = shown === 1 ? 'מתכון אחד' : `${shown} מתכונים`;
    empty.hidden = shown > 0;
  }

  input.addEventListener('input', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      category = chip.dataset.cat ?? '';
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      apply();
    });
  }
  // Browsers restore the field value on back navigation; keep the list in sync.
  apply();
</script>

<style>
  .home {
    max-width: 760px;
    margin-inline: auto;
  }

  /* Header */
  .hero {
    text-align: center;
    margin-block-end: 20px;
  }

  .hero__emoji {
    display: block;
    font-size: 38px;
    line-height: 1;
  }

  .hero__title {
    margin: 6px 0 0;
    font-size: 40px;
    font-weight: 900;
    line-height: 1.15;
    color: var(--accent-strong);
  }

  .hero__sub {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  .hero__rule {
    margin-block-start: 10px;
  }

  /* Search */
  .search {
    margin-block-end: 16px;
  }

  .search__input {
    width: 100%;
    min-height: 48px;
    padding: 12px 22px;
    font: inherit;
    font-size: 15px;
    color: var(--text);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 999px;
  }

  .search__input::placeholder {
    color: var(--placeholder);
    opacity: 1;
  }

  .search__input:focus {
    border-color: var(--accent);
    outline: none;
  }

  /* Chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-block-end: 20px;
  }

  .chip {
    min-height: var(--tap);
    padding: 7px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-2);
    background: var(--surface);
    color: var(--muted-3);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    white-space: nowrap;
  }

  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  /* Count + grid */
  .status {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
  }

  .card__link {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: center;
    padding: 16px 18px;
    background: var(--surface);
    border-radius: var(--card-radius);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .card__link:hover,
  .card__link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(60, 40, 20, 0.14);
  }

  .card__tile {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tile);
    border-radius: 12px;
    font-size: 24px;
    line-height: 1;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card__title {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text);
  }

  .card__badge {
    display: inline-block;
    vertical-align: middle;
    margin-inline-start: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--brown-deep);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.4;
  }

  .card__meta {
    font-size: 13px;
    color: var(--muted-2);
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding-block: 2rem;
  }

  @media (min-width: 640px) {
    .chip {
      min-height: 0;
    }
  }
</style>
