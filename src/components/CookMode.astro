---
/**
 * Cooking mode (SPEC 3.3): wake lock, big tappable step cards, check-off
 * persisted in localStorage per recipe. Toggled by the #cook hash so the
 * browser back button exits. Timers come in the next step.
 */
import '../styles/cook.css';
---

<div class="cook-bar" id="cook-bar" hidden>
  <button class="cook-bar__btn cook-bar__btn--exit" id="cook-exit" type="button">יציאה</button>
  <span class="cook-bar__progress" id="cook-progress" aria-live="polite"></span>
  <button class="cook-bar__btn" id="cook-reset" type="button">איפוס</button>
</div>
<p class="cook-lock" id="cook-lock" hidden>☀️ המסך יישאר דלוק</p>

<div class="timer-bar" id="timer-bar" hidden role="region" aria-label="טיימר">
  <div class="timer-bar__info">
    <span class="timer-bar__label" id="timer-label"></span>
    <span class="timer-bar__time" id="timer-time" aria-live="off">00:00</span>
  </div>
  <div class="timer-bar__actions">
    <button class="cook-bar__btn" id="timer-toggle" type="button">השהיה</button>
    <button class="cook-bar__btn" id="timer-reset" type="button">איפוס</button>
    <button class="cook-bar__btn cook-bar__btn--exit" id="timer-close" type="button" aria-label="סגירת הטיימר">✕</button>
  </div>
</div>

<script>
  const root = document.documentElement;
  const article = document.querySelector<HTMLElement>('.recipe')!;
  const slug = article.dataset.slug ?? location.pathname;
  const storageKey = `cook:${slug}`;

  const bar = document.getElementById('cook-bar')!;
  const lockIndicator = document.getElementById('cook-lock')!;
  const progress = document.getElementById('cook-progress')!;
  const enterBtn = document.getElementById('cook-enter') as HTMLButtonElement;
  const exitBtn = document.getElementById('cook-exit')!;
  const resetBtn = document.getElementById('cook-reset')!;

  const ingredients = document.querySelector<HTMLElement>('.recipe__ingredients')!;
  const stepsSection = document.querySelector<HTMLElement>('.recipe__steps')!;
  const steps = Array.from(document.querySelectorAll<HTMLLIElement>('.steps__item'));
  const ingredientsHome = ingredients.parentElement!;

  // Collapsible ingredients panel shown only in cooking mode; the real
  // ingredients section is moved into it so checkbox state is kept.
  const panel = document.createElement('details');
  panel.className = 'cook-ingredients';
  panel.hidden = true;
  const summary = document.createElement('summary');
  summary.textContent = 'מצרכים';
  panel.append(summary);
  stepsSection.prepend(panel);

  let cooking = false;
  let wakeLock: WakeLockSentinel | null = null;

  // --- persistence ---
  function loadDone(): Set<number> {
    try {
      const raw = localStorage.getItem(storageKey);
      const arr = raw ? (JSON.parse(raw) as unknown) : [];
      return new Set(Array.isArray(arr) ? arr.filter((n) => typeof n === 'number') : []);
    } catch {
      return new Set();
    }
  }

  function saveDone(done: Set<number>) {
    try {
      if (done.size === 0) localStorage.removeItem(storageKey);
      else localStorage.setItem(storageKey, JSON.stringify([...done]));
    } catch {
      /* private mode etc. */
    }
  }

  let done = loadDone();

  function render() {
    steps.forEach((li, i) => {
      const isDone = done.has(i);
      li.classList.toggle('is-done', isDone);
      li.setAttribute('aria-pressed', String(isDone));
    });
    progress.textContent = `${done.size} / ${steps.length}`;
  }

  function toggleStep(i: number) {
    if (!cooking) return;
    if (done.has(i)) done.delete(i);
    else done.add(i);
    saveDone(done);
    render();
  }

  // --- wake lock ---
  async function requestWakeLock() {
    if (!('wakeLock' in navigator)) return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      lockIndicator.hidden = false;
      wakeLock.addEventListener('release', () => {
        lockIndicator.hidden = true;
      });
    } catch {
      lockIndicator.hidden = true;
    }
  }

  async function releaseWakeLock() {
    try {
      await wakeLock?.release();
    } catch {
      /* ignore */
    }
    wakeLock = null;
    lockIndicator.hidden = true;
  }

  document.addEventListener('visibilitychange', () => {
    if (cooking && document.visibilityState === 'visible') void requestWakeLock();
  });

  // --- enter / exit ---
  function enter() {
    if (cooking) return;
    cooking = true;
    root.classList.add('is-cooking');
    bar.hidden = false;
    panel.hidden = false;
    panel.open = false;
    panel.append(ingredients);
    steps.forEach((li) => {
      li.setAttribute('role', 'button');
      li.tabIndex = 0;
    });
    done = loadDone();
    render();
    void requestWakeLock();
    window.scrollTo({ top: 0 });
  }

  function exit() {
    if (!cooking) return;
    cooking = false;
    root.classList.remove('is-cooking');
    bar.hidden = true;
    panel.hidden = true;
    ingredientsHome.prepend(ingredients);
    steps.forEach((li) => {
      li.removeAttribute('role');
      li.removeAttribute('aria-pressed');
      li.removeAttribute('tabindex');
      li.classList.remove('is-done');
    });
    closeTimer();
    void releaseWakeLock();
  }

  function syncToHash() {
    if (location.hash === '#cook') enter();
    else exit();
  }

  enterBtn.addEventListener('click', () => {
    history.pushState({ cook: true }, '', '#cook');
    enter();
  });

  exitBtn.addEventListener('click', () => {
    if (history.state && history.state.cook) history.back();
    else {
      history.replaceState(null, '', location.pathname + location.search);
      exit();
    }
  });

  resetBtn.addEventListener('click', () => {
    done = new Set();
    saveDone(done);
    render();
  });

  steps.forEach((li, i) => {
    li.addEventListener('click', () => toggleStep(i));
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleStep(i);
      }
    });
  });

  // --- timers (one at a time) ---
  const timerBar = document.getElementById('timer-bar')!;
  const timerLabel = document.getElementById('timer-label')!;
  const timerTime = document.getElementById('timer-time')!;
  const timerToggle = document.getElementById('timer-toggle')!;
  const timerReset = document.getElementById('timer-reset')!;
  const timerClose = document.getElementById('timer-close')!;

  interface Timer {
    total: number;
    remaining: number; // seconds left while paused
    endAt: number; // ms timestamp while running
    running: boolean;
    finished: boolean;
    stepIndex: number;
  }
  let timer: Timer | null = null;
  let tickHandle: number | null = null;
  let audio: AudioContext | null = null;

  const pad = (n: number) => String(n).padStart(2, '0');
  function formatClock(s: number) {
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    return h > 0 ? `${h}:${pad(m)}:${pad(sec)}` : `${pad(m)}:${pad(sec)}`;
  }

  function unlockAudio() {
    try {
      audio ??= new AudioContext();
      if (audio.state === 'suspended') void audio.resume();
    } catch {
      audio = null;
    }
  }

  function beep() {
    if (!audio) return;
    try {
      const t0 = audio.currentTime;
      for (let i = 0; i < 4; i++) {
        const t = t0 + i * 0.4;
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        osc.type = 'sine';
        osc.frequency.value = i % 2 ? 1175 : 880;
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(0.5, t + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
        osc.connect(gain).connect(audio.destination);
        osc.start(t);
        osc.stop(t + 0.32);
      }
    } catch {
      /* ignore */
    }
  }

  function vibrate() {
    try {
      navigator.vibrate?.([300, 150, 300, 150, 600]);
    } catch {
      /* ignore */
    }
  }

  function secondsLeft(): number {
    if (!timer) return 0;
    return timer.running ? Math.max(0, Math.ceil((timer.endAt - Date.now()) / 1000)) : timer.remaining;
  }

  function renderTimer() {
    if (!timer) return;
    const left = secondsLeft();
    timerTime.textContent = formatClock(left);
    timerToggle.textContent = timer.running ? 'השהיה' : 'המשך';
    timerToggle.hidden = timer.finished;
    timerBar.classList.toggle('is-finished', timer.finished);
    timerBar.classList.toggle('is-paused', !timer.running && !timer.finished);
    timerLabel.textContent = timer.finished ? '⏰ הזמן נגמר!' : `שלב ${timer.stepIndex + 1}`;
    steps.forEach((li, i) => li.classList.toggle('has-timer', i === timer!.stepIndex));
  }

  function stopTicking() {
    if (tickHandle !== null) {
      clearInterval(tickHandle);
      tickHandle = null;
    }
  }

  function tick() {
    if (!timer || !timer.running) return;
    if (secondsLeft() <= 0) finishTimer();
    renderTimer();
  }

  function finishTimer() {
    if (!timer) return;
    timer.running = false;
    timer.remaining = 0;
    timer.finished = true;
    stopTicking();
    beep();
    vibrate();
    renderTimer();
  }

  function startTimer(seconds: number, stepIndex: number) {
    unlockAudio();
    stopTicking();
    timer = {
      total: seconds,
      remaining: seconds,
      endAt: Date.now() + seconds * 1000,
      running: true,
      finished: false,
      stepIndex,
    };
    timerBar.hidden = false;
    root.classList.add('has-timer');
    tickHandle = window.setInterval(tick, 250);
    renderTimer();
  }

  function closeTimer() {
    stopTicking();
    timer = null;
    timerBar.hidden = true;
    root.classList.remove('has-timer');
    steps.forEach((li) => li.classList.remove('has-timer'));
  }

  timerToggle.addEventListener('click', () => {
    if (!timer || timer.finished) return;
    if (timer.running) {
      timer.remaining = secondsLeft();
      timer.running = false;
      stopTicking();
    } else {
      timer.endAt = Date.now() + timer.remaining * 1000;
      timer.running = true;
      tickHandle = window.setInterval(tick, 250);
    }
    renderTimer();
  });

  timerReset.addEventListener('click', () => {
    if (!timer) return;
    startTimer(timer.total, timer.stepIndex);
  });

  timerClose.addEventListener('click', closeTimer);

  steps.forEach((li, i) => {
    const btn = li.querySelector<HTMLButtonElement>('.step-timer');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const seconds = Number(btn.dataset.seconds);
      if (seconds > 0) startTimer(seconds, i);
    });
    btn.addEventListener('keydown', (e) => e.stopPropagation());
  });

  // Catch up after the tab was in the background (timers there are throttled).
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') tick();
  });

  window.addEventListener('popstate', syncToHash);
  window.addEventListener('hashchange', syncToHash);
  syncToHash();
</script>
