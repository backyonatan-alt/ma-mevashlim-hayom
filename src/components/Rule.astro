---
/** Two gold bars flanking a terracotta diamond (design handoff divider). */
interface Props {
  bar?: number;
}
const { bar = 50 } = Astro.props;
---

<span class="rule" aria-hidden="true" style={`--bar:${bar}px`}><i class="rule__gem"></i></span>

<style>
  .rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .rule::before,
  .rule::after {
    content: '';
    width: var(--bar);
    height: 3px;
    background: var(--gold);
    border-radius: 2px;
  }

  .rule__gem {
    display: block;
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: rotate(45deg);
  }
</style>
